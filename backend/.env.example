GEMINI_API_KEY=replace_with_gemini_key
FACE_API_KEY=replace_with_faceplusplus_key
FACE_API_SECRET=replace_with_faceplusplus_secret
# Optional: required token for websocket auth if you want to lock down /ws/audio
WS_AUTH_TOKEN=replace_with_random_token
# Optional: comma-separated frontend origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
